// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// -------------------------
// enums
// -------------------------

enum UserStatus {
  active
  inactive
}

enum TeamStatus {
  active
  inactive
}

enum ExpenseStatus {
  pending
  approved
  rejected
}

enum BudgetStatus {
  draft
  allocated
}

enum LeaveType {
  sick
  vacation
  parental
  unpaid
  other
}

enum LeaveStatus {
  pending
  approved
  ejected
}

enum Priority {
  low
  medium
  high
  critical
}

enum FeatureStatus {
  submitted
  under_review
  planned
  in_progress
  shipped
  declined
}

enum ReleaseStatus {
  draft
  published
  rolled_back
}

enum EmploymentStatus {
  active
  on_leave
  offboarded
}

enum PolicyStatus {
  draft
  publiched
  rchived
}

// ─────────────────────────────────────────
// Generators
// ─────────────────────────────────────────

generator json {
  provider = "prisma-json-types-generator"
}

// -------------------------
// models
// -------------------------

model User {
  id                String     @id @default(uuid())
  firstname         String     @db.VarChar(32)
  lastname          String     @db.VarChar(32)
  email             String     @unique
  /// [ImageDto]
  image             Json?
  password          String?    @db.VarChar(255)
  passwordChangedAt DateTime?
  refreshToken      String?    @unique
  otp               String?
  otpExpiresAt      DateTime?
  isEmailVerified   Boolean    @default(false)
  status            UserStatus @default(active)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  membership Membership[] @relation("UserMembership")
  invitees   Membership[] @relation("MembershipInvitedBy")
  auditlogs  Audit[]
  budgets    Budget[]
}

model Team {
  id     String     @id @default(uuid())
  name   String
  status TeamStatus @default(active)

  members       Membership[]
  permissions   Permissions[]
  budgets       Budget[]
  expense       Expense[]
  employees     Employee[]
  leaves        Leave[]
  features      Feature[]
  releases      Release[]
  policies      Policy[]
  announcements Announcement[]
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  invitedBy String
  teamId    String
  role      String   @default("member")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User @relation("UserMembership", fields: [userId], references: [id], onDelete: Cascade)
  inviter User @relation("MembershipInvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)
  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Role {
  id              String            @id @default(uuid())
  name            String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rolePermissions RolePermissions[]
}

model Permissions {
  id        String   @id @default(uuid())
  name      String   @unique
  teamId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermissions[]
  team            Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model RolePermissions {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissions Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Audit {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

model Budget {
  id              String       @id @default(uuid())
  teamId          String
  name            String // e.g. "Q3 Marketing Budget"
  totalAmount     Decimal      @db.Decimal(12, 2)
  allocatedAmount Decimal      @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal      @db.Decimal(12, 2)
  period          String // e.g. "2026-Q3"
  status          BudgetStatus @default(draft)
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Expense {
  id              String        @id @default(uuid())
  teamId          String
  submittedById   String
  title           String
  amount          Decimal
  category        String // e.g. "Travel", "Equipment"
  receiptUrl      String?
  status          ExpenseStatus @default(pending)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([status])
}

model Employee {
  id               String           @id @default(uuid())
  teamId           String
  userId           String           @unique // links to the User being described
  jobTitle         String
  department       String
  salary           Decimal?
  startDate        DateTime
  endDate          DateTime?
  employmentStatus EmploymentStatus @default(active)
  managerId        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Leave {
  id            String      @id @default(uuid())
  teamId        String
  requestedById String
  type          LeaveType
  startDate     DateTime
  endDate       DateTime
  reason        String?
  status        LeaveStatus @default(pending)
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime    @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([status])
}

model Feature {
  id            String        @id @default(cuid())
  teamId        String
  title         String
  description   String
  requestedById String
  priority      Priority      @default(medium)
  status        FeatureStatus @default(submitted)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@index([status])
}

model Release {
  id            String        @id @default(cuid())
  teamId        String
  version       String // e.g. "v1.4.0"
  title         String
  changelog     String
  status        ReleaseStatus @default(draft)
  publishedById String?
  publishedAt   DateTime?
  rolledBackAt  DateTime?
  createdAt     DateTime      @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, version])
  @@index([teamId])
}

model Policy {
  id            String       @id @default(cuid())
  teamId        String
  title         String
  content       String
  version       Int          @default(1)
  status        PolicyStatus @default(draft)
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId])
}

model Announcement {
  id         String   @id @default(cuid())
  teamId     String
  title      String
  body       String
  postedById String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId])
}
